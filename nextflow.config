nextflow.enable.dsl=2

params {
    config          = null          // required: path to analysis CSV
    data_dir        = null          // required: directory containing all FASTA files
    project         = null          // optional: defaults to config CSV basename (see below)
    outdir          = "results"

    run_tool        = "phmmer"      // phmmer | diamond | blast
    evalue          = 1e-5          // fallback e-value for proteins with no detectable paralog
    parse_evalue    = 0.01          // loose noise ceiling for parse_hits; final per-gene
                                    // filtering is done in build_presence_matrix using paralog cutoffs
    ingroup_min_frac = 0.75         // fraction of ingroup that must contain a hit
    outgroup_min_frac = 0.75        // fraction of outgroup that must contain a hit, for LOSS_SEARCH
    loss_ingroup_max_frac = 0.0     // max fraction of ingroup a loss candidate may survive in
                                    // (0.0 = strictly absent; raise for "nearly missing" losses)
    core_min_frac    = 0.95         // presence fraction (all proteomes) for the CORE genes report
    paralog_competition_scope = 'proteome'  // filter-2 granularity: 'proteome' (strict, default) or
                                            // 'target' (only disqualify a hit the query's paralog
                                            // beats on the SAME target protein; keeps HEX-1-like
                                            // orthologs whose paralog wins on a different gene)

    use_orthofinder = false         // use OrthoFinder instead of mmseqs2 for clustering

    // --- Family-profile search pathway (ADR-0002) ---
    // cluster_tool selects the novelty-direction presence-matrix producer:
    //   pairwise (default) — O(N^2) phmmer/diamond/blast SEARCH
    //   mmseqs             — cluster ingroup into families → famsa → hmmbuild → hmmsearch
    //   novelty_discovery  — two-phase targeted novelty pipeline (novelty_discovery → novelty_screen)
    cluster_tool          = "pairwise"   // pairwise | mmseqs | novelty_discovery
    // Family definition (mmseqs cluster of the ingroup). Shipped defaults; SWEEP these
    // (family_min_seq_id 0.2–0.5, hmm_presence_* below) per ADR-0002 Q3/Q8.
    family_sensitivity    = 7            // mmseqs -s (cascaded prefilter sensitivity)
    family_min_seq_id     = 0.3          // mmseqs --min-seq-id
    family_cov            = 0.8          // mmseqs -c (coverage; guards domain over-merging)
    family_cov_mode       = 0            // mmseqs --cov-mode (0 = bidirectional)
    family_cluster_mode   = 0            // mmseqs --cluster-mode (0 = greedy set-cover)
    family_min_members    = 2            // profile only families with >= this many members
    family_max_members    = 100          // and drop families with MORE than this many members —
                                         // an ancient multi-copy superfamily (e.g. aldehyde
                                         // dehydrogenase) this large is present across most of
                                         // the tree by construction, so it cannot pass the
                                         // novelty/loss predicate either way; it's also the
                                         // dominant famsa cost outlier (issue #22 follow-up).
                                         // Skipped families are logged to oversized_families.tsv.
    family_align_timeout  = 600          // per-family safety net (seconds): if famsa/hmmbuild
                                         // for one family exceeds this inside a BUILD_CHUNK task,
                                         // skip just that family (logged) rather than losing the
                                         // whole chunk's other families to a queue timeout.
    family_chunk_size     = 50           // families per BUILD_CHUNK task (scatter-gather of
                                         // famsa+hmmbuild). Smaller = more parallelism / more
                                         // jobs; sized down (was 200) because BUILD_CHUNK runs
                                         // on the preemptible `preempt` queue and needs to
                                         // finish quickly between preemptions.
    // Family HMM search + presence rule (ADR-0002 Q5). Report loosely, filter strictly.
    hmm_report_evalue     = 10           // hmmsearch -E reporting ceiling (loose on purpose)
    hmm_Z                 = null         // hmmsearch -Z (fixed db size for comparable E-values)
    hmm_presence_evalue   = 1e-3         // presence: full-seq E-value ceiling (swept)
    hmm_presence_cov      = 0.5          // presence: min profile coverage (swept)
    hmm_search_chunk_size = 500          // HMMs per FAMILY_HMMSEARCH chunk (scatter-gather of
                                         // the family-db scan, issue #22). One (proteome x
                                         // chunk) job per unit; sized down (was 2000) because
                                         // FAMILY_HMMSEARCH runs on the preemptible `preempt`
                                         // queue and needs to finish quickly between preemptions.

    // Interactive HTML report — which proteins carry an embedded sequence.
    // Sequences dominate report.html's size, so "all" is opt-in.
    report_sequences = "novelties"  // novelties | all | none

    // PDF summary report (view/<project>/summary.pdf). Gated by MAKE_PDF_REPORT's
    // `when:` directive — set false to skip the step (e.g. no matplotlib available).
    pdf_report = true

    // Functional annotation databases (set to null to skip that annotation step)
    pfam_hmm        = null          // path to Pfam-A.hmm (from db/pfam/)
    swissprot_dmnd  = null          // path to uniprot_sprot.fasta.dmnd (from db/uniprot/)

    // Model organism gene name lookups — YAML config listing reference organisms
    // See configs/modelorgs.yaml for format and examples
    modelorgs_config = null

    // MPI mode for hmmsearch (requires HMMER compiled with MPI, e.g. via conda-forge)
    // When true, runs:  mpirun -np <hmm_mpi_tasks> hmmsearch --mpi ...
    // When false, runs: hmmsearch --cpu <task.cpus> ...
    hmm_mpi         = false
    hmm_mpi_tasks   = null          // MPI task count; defaults to max_cpus when hmm_mpi=true

    max_cpus        = 32
    max_memory      = '64.GB'
    max_time        = '24.h'
}

process {
    cpus   = { Math.min(8, params.max_cpus as int) }
    memory = '8.GB'
    time   = '2.h'

    // Runs before every task script, inside the task's work directory.
    // 1. Activate the pixi-managed conda environment.
    // 2. Symlink the project db/ directory so that relative DB paths
    //    (e.g. db/pfam/38.2/Pfam-A.hmm) resolve correctly from the work dir.
    beforeScript = """\
    export PATH="\$HOME/.pixi/bin:\$PATH"
    eval "\$(pixi shell-hook -s bash --manifest-path ${projectDir}/pixi.toml)"
    [ -e db ]      || ln -s ${projectDir}/db db
    [ -e configs ] || ln -s ${projectDir}/configs configs
    """.stripIndent()

    withLabel: 'high_cpu' {
        cpus   = { Math.min(8, params.max_cpus as int) }
        memory = '16.GB'
    }
    withLabel: 'med_cpu' {
        cpus   = { Math.min(8, params.max_cpus as int) }
	memory = '8.GB'
    }
    withLabel: 'hmmsearch' {
        // Non-MPI default: multithreaded hmmsearch
        cpus   = 4
        memory = '8.GB'
    }
    withLabel: 'low_cpu' {
        cpus   = 1
        memory = '4.GB'
    }
}

report {
    enabled   = true
    file      = "${launchDir}/logs/${params.project ?: 'run'}-report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${launchDir}/logs/${params.project ?: 'run'}-trace.txt"
    overwrite = true
}

profiles {
    slurm {
        process.executor = 'slurm'
        // 'short' (2h limit) is fast to start and sufficient for every process
        // observed so far; retry on a failed/timed-out attempt escalates to
        // 'epyc' (30 day limit) rather than retrying on the same 2h queue.
        process.queue    = { task.attempt > 1 ? 'epyc' : 'short' }
        // Throttle submission so the O(N^2) pairwise search does not flood the
        // scheduler with thousands of jobs at once.
        executor {
            queueSize      = 100
            submitRateLimit = '50/1min'
        }
        process {
            errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
            maxRetries    = 2
            // 'short' caps time at 2h; a retry escalates to 'epyc', which
            // allows up to 30 days, so give the retried attempt real headroom.
            time          = { task.attempt > 1 ? '24.h' : '2.h' }
            withLabel: 'high_cpu' {
                cpus   = { params.max_cpus }
                memory = '32.GB'
            }
            withLabel: 'hmmsearch' {
                // MPI mode: request N single-threaded tasks via --ntasks.
                // Thread mode: request N CPUs in the normal Nextflow way.
                cpus           = { params.hmm_mpi ? 1 : 4 }
                memory         = '8.GB'
                clusterOptions = {
                    params.hmm_mpi
                        ? "--ntasks ${params.hmm_mpi_tasks ?: params.max_cpus}"
                        : ''
                }
            }
            withName: 'ANNOTATE:ANNOTATE_MATRIX' {
                // ANNOTATE_MATRIX runs hmmsearch --mpi when hmm_mpi=true.
                // MPI requires --ntasks slots, not --cpus-per-task.
                cpus           = { params.hmm_mpi ? 1 : params.max_cpus }
                memory         = '32.GB'
                clusterOptions = {
                    params.hmm_mpi
                        ? "--ntasks ${params.hmm_mpi_tasks ?: params.max_cpus}"
                        : ''
                }
            }
            withName: '.*MMSEQS.*CLUSTER' {
                // mmseqs2 needs to land on an AVX2-capable node (crashes on the
                // abu_dhabi c[01-30] nodes the 'short' partition mixes in).
                // Matches the novelty-direction CLUSTER / loss-direction
                // LOSS_CLUSTER (MMSEQS_CLUSTER) and the family-profile pathway's
                // MMSEQS_FAMILY_CLUSTER.
                clusterOptions = '-C ryzen|broadwell|cascade'
            }
            withName: '.*BUILD_CHUNK' {
                // famsa (bioconda build) requires AVX2 and SIGILLs on the
                // abu_dhabi c[01-30] nodes that the 'short' partition mixes in.
                // Constrain to AVX2-capable node classes (ryzen Zen2+, intel
                // broadwell/cascade) so scheduler placement can't crash the run.
                // (BUILD_CHUNK is the famsa carrier since the scatter-gather split.)
                // Runs on 'preempt' (not 'short') since family_chunk_size was cut to
                // keep per-task walltime short enough to tolerate preemption.
                queue          = 'preempt'
                clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
            	time           = ''
            }
            withName: '.*HMMSEARCH_CHUNK' {
                // FAMILY_HMMSEARCH's scatter-gather carrier. Runs on 'preempt' (not
                // 'short') since hmm_search_chunk_size was cut to keep per-task
                // walltime short enough to tolerate preemption.
                queue          = 'preempt'
                clusterOptions = '--account=preempt'
            }
        }
    }
    local {
        process.executor = 'local'
    }
    test {
        params.config    = "${projectDir}/tests/data/test.csv"
        params.data_dir  = "${projectDir}/tests/data"
        params.project   = "test"
        params.run_tool  = "phmmer"
        process.executor = 'local'
    }
}

singularity {
    enabled      = false
    autoMounts   = true
    cacheDir     = '/bigdata/stajichlab/shared/lib/singularity_cache'
    envWhitelist = 'SCRATCH'
}
