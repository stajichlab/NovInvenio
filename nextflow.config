nextflow.enable.dsl=2

params {
    config          = null          // required: path to analysis CSV
    data_dir        = null          // required: directory containing all FASTA files
    project         = null          // derived from config filename if not set
    outdir          = "results"

    run_tool        = "phmmer"      // phmmer | diamond | blast
    evalue          = 1e-5
    ingroup_min_frac = 0.75         // fraction of ingroup that must contain a hit

    use_orthofinder = false         // use OrthoFinder instead of mmseqs2 for clustering

    // downstream HMM search database (SwissProt/UniProt)
    hmm_db          = null

    max_cpus        = 8
    max_memory      = '64.GB'
    max_time        = '24.h'
}

process {
    cpus   = 4
    memory = '8.GB'
    time   = '4.h'

    beforeScript = "eval \"\$(pixi shell-hook -s bash -m \${projectDir}/pixi.toml)\""

    withLabel: 'high_cpu' {
        cpus   = { params.max_cpus }
        memory = '16.GB'
    }
    withLabel: 'low_cpu' {
        cpus   = 1
        memory = '4.GB'
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
        process.queue    = 'stajichlab'
        process.clusterOptions = ''
    }
    local {
        process.executor = 'local'
    }
    test {
        params.config    = "${projectDir}/tests/data/test.csv"
        params.data_dir  = "${projectDir}/tests/data"
        params.project   = "test"
        params.run_tool  = "phmmer"
        process.executor = 'local'
    }
}
