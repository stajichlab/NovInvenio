// =============================================================================
// UCR HPCC (SLURM) site configuration for NovInvenio
// =============================================================================
// This file overrides the generic defaults in nextflow.config with UCR HPCC-
// specific executor, queue, resource, and cluster-option settings.
//
// Usage (with pixi environment):
//   nextflow run stajichlab/NovInvenio \
//       -profile slurm \
//       -c conf/ucr_hpcc_slurm.config \
//       --config configs/pezizo4_asco.csv \
//       --data_dir /path/to/fastas \
//       --pfam_hmm /path/to/Pfam-A.hmm \
//       ...
//
// Usage (with Docker container):
//   nextflow run stajichlab/NovInvenio \
//       -profile docker,slurm \
//       -c conf/ucr_hpcc_slurm.config \
//       --config configs/pezizo4_asco.csv \
//       --data_dir /path/to/fastas \
//       ...
//
// Required bind-mounts when using Docker on the HPCC:
//   The HPCC's Docker-in-SLURM setup must expose the host working directory
//   and project directory to the container.  Consult the HPCC documentation
//   for the correct --bind or -B flags for your version of Singularity/UDocker.
// =============================================================================

// NOTE: `executor { ... }` (queueSize/submitRateLimit -- global executor pool settings)
// must be its own top-level scope, a *sibling* of `process { }`, not nested inside it.
// `process { executor = 'slurm' ... executor { ... } }` collides: Nextflow parses the
// first `executor = 'slurm'` as a String-valued process directive, then the nested
// `executor { }` block tries to treat that same key as a map and fails with
// "No signature of method: java.lang.String.put()".
executor {
    queueSize       = 100
    submitRateLimit = '50/1min'
}

// --bind /bigdata is required because pfam_hmm/swissprot_dmnd/modelorgs_config/
// data_dir are passed to processes as plain `val` strings (see
// workflows/annotate.nf), not `path` inputs, so Singularity's autoMounts can't
// detect and bind them on its own.
//
// The SIF cache dir is set via NXF_SINGULARITY_CACHEDIR (see run.sh) rather
// than here, so concurrent SLURM array tasks reuse one pulled/converted image
// instead of each task pulling its own copy.
singularity {
    runOptions = '--bind /bigdata'
}

process {
    executor = 'slurm'

    // Queue routing: first attempt on 'short' (2h limit), retry on 'epyc' (30d limit).
    queue = { task.attempt > 1 ? 'epyc' : 'short' }

    errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries    = 2
    // 'short' caps time at 2h; a retry escalates to 'epyc', which allows up to
    // 30 days, so give the retried attempt real headroom.
    time          = { task.attempt > 1 ? '24.h' : '2.h' }

    withLabel: 'high_cpu' {
        cpus   = { params.max_cpus }
        memory = '32.GB'
    }
    withLabel: 'hmmsearch' {
        // MPI mode: request N single-threaded tasks via --ntasks.
        // Thread mode: request N CPUs in the normal Nextflow way.
        //
        // NOTE on --cpu-bind: a multi-task (-n > 1) srun/MPI launch on this cluster fails
        // outright without --cpu-bind=none ("CPU binding outside of job step allocation")
        // -- a --cpu-bind default/cgroup-mask mismatch, not an MPI-plugin issue (see
        // nextflow-hpcc skill). --cpu-bind is an srun option, NOT accepted by sbatch --
        // confirmed `sbatch --cpu-bind=none` errors with "unrecognized option" -- and
        // Nextflow's SLURM executor submits via sbatch, so it can't go in clusterOptions
        // here. modules/hmmsearch.nf exports SLURM_CPU_BIND=none instead, which srun
        // honors as its default even when invoked indirectly (e.g. by mpirun's PMI/PMIx
        // launch under a SLURM allocation).
        cpus           = { params.hmm_mpi ? 1 : 4 }
        memory         = '8.GB'
        clusterOptions = {
            params.hmm_mpi
                ? "--ntasks ${params.hmm_mpi_tasks ?: params.max_cpus}"
                : ''
        }
    }
    // ANNOTATE_MATRIX runs hmmsearch --mpi when hmm_mpi=true (MPI requires --ntasks slots,
    // not --cpus-per-task; SLURM_CPU_BIND=none is exported in the script itself -- see
    // workflows/annotate.nf -- since --cpu-bind is an srun-only flag sbatch rejects).
    // --hmm_mpi true is a real, large win here: benchmarked on a 500-protein subset vs the
    // full Pfam-A DB, `mpirun -np 9 hmmsearch --mpi` (1 dispatcher + 8 workers) hit 860% CPU
    // / 1m54s wall, vs 94-165% CPU / 7-15min wall for hmmscan (either reading Pfam straight
    // off GPFS or from node-local scratch). hmm_mpi still defaults to false in
    // nextflow.config, so pass --hmm_mpi true explicitly to get this. Memory sized with
    // headroom above the ~2.9 GB peak RSS observed for that 9-task run; re-check at full
    // candidate-set scale and with a larger --hmm_mpi_tasks.
    withName: '(LOSS_)?ANNOTATE:ANNOTATE_MATRIX' {
        cpus           = { params.hmm_mpi ? 1 : params.max_cpus }
        memory         = '16.GB'
        clusterOptions = {
            params.hmm_mpi
                ? "--ntasks ${params.hmm_mpi_tasks ?: params.max_cpus}"
                : ''
        }
    }
    withName: '.*MMSEQS.*CLUSTER' {
        // mmseqs2 crashes on the abu_dhabi c[01-30] nodes the 'short' partition
        // mixes in — constrain to AVX2-capable node classes.
        clusterOptions = '-C ryzen|broadwell|cascade'
    }
    withName: '.*BUILD_CHUNK' {
        // famsa (bioconda build) requires AVX2 and SIGILLs on the abu_dhabi
        // c[01-30] nodes that the 'short' partition mixes in.  Runs on the
        // preemptible 'preempt' queue so BUILD_CHUNK tasks are short enough to
        // tolerate preemption.
        queue          = 'preempt'
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
        time           = ''
    }
    withName: '.*HMMSEARCH_CHUNK' {
        // FAMILY_HMMSEARCH scatter-gather on preempt queue. Its script always runs plain
        // `hmmsearch --cpu N` -- never --mpi -- so it must NOT inherit the 'hmmsearch'
        // label's hmm_mpi-conditional cpus/clusterOptions (cpus=1 + a wasted --ntasks
        // request) when hmm_mpi is set broadly for ANNOTATE_MATRIX. Fixed cpus here
        // overrides that regardless of hmm_mpi.
        queue          = 'preempt'
        clusterOptions = '--account=preempt'
        cpus           = 4
    }
}
