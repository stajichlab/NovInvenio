# pixi environments
.pixi/*
!.pixi/config.toml

# nextflow run state and outputs
.nextflow/
.nextflow.log*
work/
results/

# python
__pycache__/
*.pyc

# scratch left behind when the test profile is run in place
tests/data/.nextflow*
tests/data/logs/

# large reference/data caches — not source, too big for git
/data/
/example/
/busco_pezizo5/
/logs/
/db/uniprot/
/db/modelorgs/*.fasta
/db/modelorgs/*.fasta.dmnd

# Claude Code session-local state
.claude/*.tmp
.claude/*.log

# Sphinx build output
docs/_build/
.claude/settings.local.json
.claude/last-session.md
.claude/active-session-log.tmp
